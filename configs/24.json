          },
          {
            "name": "content",
            "type": "duplicatedText",
            "selector": "div.board-view-content"
          },
          {
            "name": "img",
            "type": "images",
            "selector": "div.board-view-content img"
          },
          {
            "name": "file",
            "type": "file",
            "optional": true,
            "selector": "div.board-file-group a.btn-download"
          }
        ]
      }
    },
    {
      "id": "step-003",
      "type": "paging",
      "params": {
