{
  "id": 22,
  "origin_id": 16,
  "name": "경기도 DMZ: 경기도 DMZ > 보도자료 > DMZ 검색",
  "description": "경기도 DMZ 포털 보도자료 DMZ 검색 (JSON API 직접 호출)",
  "baseUrl": "https://dmz.gg.go.kr",
  "startUrl": [
    "https://dmz.gg.go.kr/dmz/bbs/board.do?bsIdx=3&menuId=54&searchKeyword={keyword}"
  ],
  "keywords": [
    "DMZ",
    "디엠지",
    "비무장지대",
    "민통선",
    "민간인출입",
    "민간인통제선",
    "접경",
    "군사분계선",
    "MDL",
    "유엔사",
    "정전협정",
    "군사정전위원회"
  ],
  "scheduleTime": [
    "14:00"
  ],
  "enabled": false,
  "webhook": true,
  "steps": [
    {
      "id": "step-001",
      "type": "ajaxListApi",
      "params": {
        "apiUrl": "/dmz/bbs/ajax/boardList.do",
        "baseParams": {
          "menuId": "54",
          "bsIdx": "3",
          "categoryAllYn": "Y",
          "searchCondition": "REMARK"
        },
        "keywordFrom": "searchKeyword",
        "keywordParam": "searchKeyword",
        "pageParam": "page",
        "listPath": "resultList",
        "totalPagePath": "paginationInfo.totalPageCount",
        "detailUrlTemplate": "/dmz/bbs/boardView.do?bsIdx=${BS_IDX}&bIdx=${B_IDX}&menuId=54",
        "listFields": {
          "writer": "WRITER_NAME",
          "writedate": "WRITE_DATE2"
        }
      }
    },
    {
      "id": "step-002",
      "type": "scrapDetail",
      "params": {
        "targets": [
          {
            "name": "title",
            "type": "uniqueText",
            "selector": "div.s-v-board-default div.header h2"
          },
          {
            "name": "content",
            "type": "duplicatedText",
            "selector": "div.s-v-board-default div.content"
          },
          {
            "name": "img",
            "type": "images",
            "selector": "div.s-v-board-default div.content img"
          },
          {
            "name": "file",
            "type": "file",
            "optional": true,
            "attribute": "href",
            "selector": "div.s-v-board-default dl.file a.filename[href*='download.do']"
          }
        ]
      }
    }
  ],
  "createdAt": "2026-06-01T00:00:00.000Z",
  "updatedAt": "2026-07-14T00:00:00.000Z",
  "lastExecutedAt": "2026-07-13T05:00:26.245Z"
}