{
  "id": 18,
  "origin_id": 16,
  "name": "경기도 DMZ: DMZ 아카이브 > 갤러리 > DMZ 검색(내용)",
  "description": "경기도 DMZ 포털 갤러리 내용 기준 DMZ 검색",
  "baseUrl": "https://dmz.gg.go.kr",
  "startUrl": [
    "https://dmz.gg.go.kr/dmz/bbs/board.do?bsIdx=5&menuId=55"
  ],
  "scheduleTime": [
    "09:00"
  ],
  "enabled": false,
  "webhook": true,
  "steps": [
    {
      "id": "step-001",
      "type": "formSubmit",
      "params": {
        "fields": [
          {
            "selector": "select#searchCondition",
            "value": "REMARK"
          },
          {
            "selector": "input#searchKeyword",
            "value": "dmz"
          }
        ],
        "submitSelector": "button[onclick*='searchIt']"
      }
    },
    {
      "id": "step-002",
      "type": "detailLinks",
      "params": {
        "selector": "a.thumbnail[href*='boardView.do']",
        "attribute": "href"
      }
    },
    {
      "id": "step-003",
      "type": "scrapDetail",
      "params": {
        "targets": [
          {
            "name": "title",
            "type": "uniqueText",
            "selector": "div.s-v-board-default div.header h2"
          },
          {
            "name": "writer",
            "type": "uniqueText",
            "selector": "div.s-v-board-default div.header dl dd"
          },
          {
            "name": "writedate-list",
            "type": "uniqueText",
            "selector": "a.thumbnail[href*='boardView.do'] span.info"
          },
          {
            "name": "content",
            "type": "duplicatedText",
            "selector": "div.s-v-board-default div.content"
          },
          {
            "name": "img",
            "type": "images",
            "selector": "div.s-v-board-default div.content img"
          }
        ]
      }
    },
    {
      "id": "step-004",
      "type": "paging",
      "params": {
        "selector": "ul.pagination"
      }
    }
  ],
  "createdAt": "2026-06-01T00:00:00.000Z",
  "updatedAt": "2026-06-02T05:48:44.316Z",
